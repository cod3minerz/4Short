{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://4short.ru/schemas/hve/annotation-v1.json",
  "title": "HVE annotation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "itemId", "timebase", "ranges", "licenseRef", "annotation"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "itemId": { "type": "string", "minLength": 3 },
    "timebase": { "const": "microseconds" },
    "licenseRef": { "type": "string", "minLength": 3 },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotators", "adjudicator", "sealed"],
      "properties": {
        "annotators": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
        "adjudicator": { "type": ["string", "null"] },
        "sealed": { "type": "boolean" }
      }
    },
    "activeSpeaker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "stratum", "turns"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "stratum": { "enum": ["clean_two_person", "panel_hard"] },
        "turns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["turnId", "startUs", "endUs", "speakerId", "faceRegionId"],
            "properties": {
              "turnId": { "type": "string", "minLength": 2 },
              "startUs": { "type": "integer", "minimum": 0 },
              "endUs": { "type": "integer", "minimum": 1 },
              "speakerId": { "type": "string", "minLength": 1 },
              "faceRegionId": { "type": ["string", "null"], "minLength": 1 }
            }
          }
        }
      }
    },
    "ranges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rangeId", "startUs", "endUs", "contentType", "preferredLayouts", "acceptableLayouts", "forbiddenLayouts", "constraints"],
        "properties": {
          "rangeId": { "type": "string", "minLength": 2 },
          "startUs": { "type": "integer", "minimum": 0 },
          "endUs": { "type": "integer", "minimum": 1 },
          "contentType": { "type": "string", "minLength": 2 },
          "preferredLayouts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "acceptableLayouts": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "forbiddenLayouts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "constraints": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mustKeepRegionIds", "safeZoneIds"],
            "properties": {
              "mustKeepRegionIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "safeZoneIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "activeSpeakerRegionId": { "type": ["string", "null"] },
              "regionRoles": {
                "type": "object",
                "additionalProperties": { "enum": ["screen", "gameplay", "face", "facecam"] }
              }
            }
          }
        }
      }
    }
  }
}
