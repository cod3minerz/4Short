{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://4short.ru/schemas/hve/waiver-v1.json",
  "title": "HVE temporary gate waiver v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "waiverId", "gateId", "scope", "reason", "risk", "owner", "approvedBy", "createdAt", "expiresAt", "trackingIssue"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "waiverId": { "type": "string", "pattern": "^HVE-W-[A-Za-z0-9._-]+$" },
    "gateId": { "type": "string", "pattern": "^HVE-G[0-9]+$" },
    "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "reason": { "type": "string", "minLength": 20 },
    "risk": { "type": "string", "minLength": 20 },
    "owner": { "type": "string", "minLength": 2 },
    "approvedBy": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "trackingIssue": { "type": "string", "minLength": 5 }
  }
}
