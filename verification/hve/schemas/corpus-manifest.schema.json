{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://4short.ru/schemas/hve/corpus-manifest-v1.json",
  "title": "HVE corpus manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpusVersion", "split", "status", "createdAt", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "corpusVersion": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$" },
    "split": { "enum": ["smoke", "development", "holdout", "stress"] },
    "status": { "enum": ["scaffold", "ready"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startUs", "endUs"],
      "properties": {
        "startUs": { "type": "integer", "minimum": 0 },
        "endUs": { "type": "integer", "minimum": 1 }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId", "objectKey", "sha256", "objectBytes", "annotationKey",
        "annotationSha256", "licenseRef", "licenseArtifactSha256", "durationUs",
        "tags", "evaluationRanges"
      ],
      "properties": {
        "itemId": { "type": "string", "minLength": 3 },
        "objectKey": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "objectBytes": { "type": "integer", "minimum": 0 },
        "annotationKey": { "type": "string", "minLength": 1 },
        "annotationSha256": { "$ref": "#/$defs/sha256" },
        "licenseRef": { "type": "string", "minLength": 3 },
        "licenseArtifactSha256": { "$ref": "#/$defs/sha256" },
        "durationUs": { "type": "integer", "minimum": 1 },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(content|faces|speech|geometry|codec|quality|failure)/[A-Za-z0-9._-]+$" }
        },
        "evaluationRanges": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/range" }
        }
      }
    }
  }
}
