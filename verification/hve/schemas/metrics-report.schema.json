{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://4short.ru/schemas/hve/metrics-report-v1.json",
  "title": "HVE metrics report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "candidate", "environment", "suites", "status", "createdAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 8 },
    "createdAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["PASS", "FAIL", "INSUFFICIENT", "ERROR", "SKIPPED"] },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitSha", "imageDigest", "engineVersion", "plannerVersion", "rendererVersion", "modelHashes"],
      "properties": {
        "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "imageDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "engineVersion": { "type": "string" },
        "plannerVersion": { "type": "string" },
        "rendererVersion": { "type": "string" },
        "modelHashes": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
      }
    },
    "environment": { "type": "string", "minLength": 3 },
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "metrics", "failedItems"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["PASS", "FAIL", "INSUFFICIENT", "ERROR", "SKIPPED"] },
          "metrics": { "type": "object", "additionalProperties": { "type": ["number", "integer", "boolean", "string", "null"] } },
          "failedItems": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
