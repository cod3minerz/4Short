{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://4short.ru/schemas/hve/gate-definition-v1.json",
  "title": "HVE gate registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "exitCodes", "composition", "gates"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "exitCodes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PASS", "FAIL", "INSUFFICIENT", "ERROR", "SKIPPED"],
      "properties": {
        "PASS": { "const": 0 },
        "FAIL": { "const": 1 },
        "INSUFFICIENT": { "const": 2 },
        "ERROR": { "const": 3 },
        "SKIPPED": { "const": 4 }
      }
    },
    "composition": { "const": "union" },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "roadmap", "description", "fileGlobs", "requiredSuites", "requiredArtifacts"],
        "properties": {
          "id": { "type": "string", "pattern": "^HVE-G[0-9]+$" },
          "status": { "enum": ["scaffold", "active", "retired"] },
          "roadmap": { "type": "string", "pattern": "^HVE-[0-9]+$" },
          "description": { "type": "string", "minLength": 8 },
          "fileGlobs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "requiredSuites": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "requiredArtifacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  }
}
