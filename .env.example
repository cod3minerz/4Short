# Public web
NEXT_PUBLIC_CONTROL_API_URL=http://localhost:4100
NEXT_PUBLIC_APP_ENV=development

# Control plane (Timeweb Cloud)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/4short
DATABASE_SSL=disable
# Production Timeweb PostgreSQL:
# DATABASE_SSL=verify-full
# DATABASE_SSL_ROOT_CERT=/etc/ssl/certs/timeweb-cloud-root.crt
DATABASE_SSL_ROOT_CERT=
DATABASE_POOL_SIZE=10
HOST=127.0.0.1
PORT=4100
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4100
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Comma-separated emergency bootstrap allowlist. After the first login, assign
# persisted roles in /admin and keep this list limited to platform owners.
PLATFORM_ADMIN_EMAILS=owner@example.com
WORKER_API_TOKEN=replace-with-at-least-32-random-characters
# HVE documents are immutable render inputs. Keep this false until the focus
# editor is deployed with the typed draft-command client; otherwise the legacy
# v1 editor could make a later save that cannot preserve a v2 document.
HVE_INITIAL_DOCUMENTS_ENABLED=false
# Leave disabled until the HVE-G6 corpus + layout-director benchmark is
# approved for the deployed engine release. Manual verified layouts still work.
HVE_AUTOMATIC_LAYOUT_DIRECTOR_ENABLED=false

# Dedicated media worker. In production this points to the public control API;
# the API and worker must use the same WORKER_API_TOKEN.
CONTROL_API_URL=http://localhost:4100
WORKER_ID=media-worker-local-1
WORKER_VERSION=0.2.0
HVE_RENDERER_VERSION=hve-renderer-v2-font-pack-1
WORKER_MODE=12gb
FFMPEG_THREADS=4
LEASE_SECONDS=120
HEARTBEAT_SECONDS=30
REGISTRATION_SECONDS=30
SCRATCH_ROOT=/var/lib/4short/jobs
HEALTH_FILE=/tmp/4short-worker-ready

# Optional Yandex ID login. This is authentication only and is unrelated to STT.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Unisender Go
UNISENDER_GO_API_KEY=
UNISENDER_GO_FROM_EMAIL=
UNISENDER_GO_FROM_NAME=4Short

# Timeweb Cloud Object Storage
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_FORCE_PATH_STYLE=true
# Timeweb S3 does not require the AWS SSE header. Use AES256 only if the
# selected bucket/endpoint explicitly supports it.
S3_SERVER_SIDE_ENCRYPTION=none
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Timeweb creates one physical bucket. Set S3_BUCKET in production; the
# per-kind bucket variables below remain as a backwards-compatible fallback.
S3_BUCKET=
S3_RAW_BUCKET=4short-raw
S3_PROXY_BUCKET=4short-proxy
S3_DERIVED_BUCKET=4short-derived
S3_ASSETS_BUCKET=4short-brand-assets
S3_RAW_PREFIX=raw
S3_PROXY_PREFIX=proxy
S3_DERIVED_PREFIX=derived
S3_ASSETS_PREFIX=assets
# The editor validates this origin against a one-byte Range request before
# enabling Canvas composition preview. Configure the bucket CORS policy for
# this exact public dashboard origin (and no wildcard credential policy).
# WEB_ORIGIN=https://4short.ru

# HVE verification corpus (release evaluator only — never expose these to the
# application, browser, CI logs, or implementation worker). A ready corpus is
# independently hashed from S3 and its index is signed with this separate
# evaluator key. The public key is used by `hve:corpus:verify` only.
HVE_CORPUS_S3_ENDPOINT=https://s3.twcstorage.ru
HVE_CORPUS_S3_REGION=ru-1
HVE_CORPUS_S3_FORCE_PATH_STYLE=true
HVE_CORPUS_S3_BUCKET=
HVE_CORPUS_S3_ACCESS_KEY_ID=
HVE_CORPUS_S3_SECRET_ACCESS_KEY=
HVE_CORPUS_INDEX_SIGNING_PRIVATE_KEY=
HVE_CORPUS_INDEX_PUBLIC_KEY_FILE=/etc/4short/hve-evaluator-public.pem
HVE_CORPUS_VERIFIER_ID=timeweb-release-evaluator
HVE_CORPUS_MAX_OBJECT_BYTES=16106127360
HVE_CORPUS_MAX_ANNOTATION_BYTES=16777216

# Local STT. Transcription never leaves the dedicated media worker.
STT_MODEL=large-v3-turbo
# Pre-provision the exact CTranslate2 pack on the worker volume. The worker
# refuses STT if this manifest/fingerprint pair is missing or changed; it
# never downloads a model while processing a customer job.
STT_MODEL_PATH=/var/lib/4short/models/large-v3-turbo
# STT_MODEL_MANIFEST=/var/lib/4short/models/large-v3-turbo/hve-model-manifest.json
STT_MODEL_FINGERPRINT=
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_CPU_THREADS=8
STT_NUM_WORKERS=1
STT_BEAM_SIZE=5
STT_VAD_FILTER=true
STT_VAD_MIN_SILENCE_MS=500
STT_VAD_SPEECH_PAD_MS=120

# CPU face tracking. The worker image ships a pinned OpenCV YuNet INT8 model.
FACE_TRACKING_ENABLED=true
FACE_DETECTOR_MODEL=/opt/4short/models/face_detection_yunet_2023mar_int8.onnx
# The production image sets this verified hash itself. Do not define this in
# `/etc/4short/media-worker.env`: an empty env-file value would override the
# image pin and deliberately disable face tracking. Locally, set the exact
# SHA-256 only after verifying the supplied model.
# FACE_DETECTOR_FINGERPRINT=321aa5a6afabf7ecc46a3d06bfab2b579dc96eb5c3be7edd365fa04502ad9294
FACE_DETECTOR_SCORE_THRESHOLD=0.82
FACE_SAMPLE_FPS=3
FACE_DETECTOR_MAX_WIDTH=640
FACE_TRACK_SMOOTHING=0.82
VISION_SOURCE_SAMPLE_FPS=0.5
VISION_SOURCE_MAX_SAMPLES=8000
# Dense visual facts are only requested for one selected clip range.  Keep
# this bounded: it improves a requested crop track without competing with
# transcription or silently scanning every source at high FPS.
VISION_CLIP_SAMPLE_FPS=3.0
VISION_CLIP_MAX_SAMPLES=1500
VISION_SCENE_CUT_THRESHOLD=0.34

# LLM routing. Models must also be present in LLM_ALLOWED_MODELS.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_CANDIDATE_MODEL=deepseek/deepseek-v4-flash
LLM_RERANK_MODEL=deepseek/deepseek-v4-pro
LLM_ALLOWED_MODELS=deepseek/deepseek-v4-flash,deepseek/deepseek-v4-pro
LLM_BLOCKED_MODEL_PREFIXES=openai/,anthropic/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# T-Bank internet acquiring
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_API_URL=https://securepay.tinkoff.ru/v2
PAYMENT_RETURN_URL=http://localhost:3000/dashboard/billing

# Abuse protection
RATE_LIMIT_MAX=240
RATE_LIMIT_WINDOW=1 minute
