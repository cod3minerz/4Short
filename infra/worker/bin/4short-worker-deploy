#!/usr/bin/env bash
set -Eeuo pipefail

umask 027

release_sha="${1:-}"
archive_path="${2:-}"
release_root="/opt/4short/releases"
current_link="/opt/4short/current-worker"

if [[ ! "${release_sha}" =~ ^[0-9a-f]{40}$ ]]; then
  echo "Expected a full 40-character Git commit SHA." >&2
  exit 2
fi

expected_archive="/tmp/4short-worker-${release_sha}.tar.gz"
if [[ "${archive_path}" != "${expected_archive}" || ! -f "${archive_path}" ]]; then
  echo "Release archive path is invalid." >&2
  exit 2
fi

if [[ ! -s /etc/4short/media-worker.env ]]; then
  echo "/etc/4short/media-worker.env is not configured." >&2
  exit 2
fi

# Bind mounts may be created by Docker as root before the first container
# starts. Reassert the non-root worker ownership on every release.
install -d -m 0750 -o 10001 -g 10001 /var/lib/4short/jobs /var/lib/4short/models

release_dir="${release_root}/${release_sha}"
image_tag="${release_sha:0:12}"
previous_release=""
previous_tag=""

if [[ -L "${current_link}" ]]; then
  previous_release="$(readlink -f "${current_link}")"
  if [[ -f "${previous_release}/.worker-image-tag" ]]; then
    previous_tag="$(<"${previous_release}/.worker-image-tag")"
  fi
fi

rollback() {
  local exit_code=$?
  if [[ -n "${previous_release}" && -f "${previous_release}/compose.worker.yml" ]]; then
    echo "Worker deployment failed; restoring the previous release." >&2
    (
      cd "${previous_release}"
      FOURSHORT_IMAGE_TAG="${previous_tag}" docker compose -f compose.worker.yml up -d --no-build
    ) || true
    ln -sfn "${previous_release}" "${current_link}"
  fi
  exit "${exit_code}"
}
trap rollback ERR

install -d -m 0750 -o root -g deploy "${release_root}" "${release_dir}"
tar --extract --gzip --file "${archive_path}" --directory "${release_dir}" --no-same-owner
chown -R root:deploy "${release_dir}"

cd "${release_dir}"
printf '%s\n' "${image_tag}" > .worker-image-tag
chmod 0640 .worker-image-tag

FOURSHORT_IMAGE_TAG="${image_tag}" docker compose -f compose.worker.yml config --quiet
build_succeeded=false
for attempt in 1 2 3 4; do
  if FOURSHORT_IMAGE_TAG="${image_tag}" docker compose -f compose.worker.yml build media-worker; then
    build_succeeded=true
    break
  fi
  echo "Worker image build attempt ${attempt} failed; retrying." >&2
  sleep $((attempt * 10))
done
[[ "${build_succeeded}" == "true" ]]

if grep -Eq '^STT_PROVIDER=faster_whisper$' /etc/4short/media-worker.env; then
  FOURSHORT_IMAGE_TAG="${image_tag}" docker compose -f compose.worker.yml run --rm --no-deps \
    --entrypoint python media-worker -c \
    "from faster_whisper import WhisperModel; WhisperModel('large-v3-turbo', device='cpu', compute_type='int8', cpu_threads=8, num_workers=1, download_root='/var/lib/4short/models')"
fi

FOURSHORT_IMAGE_TAG="${image_tag}" docker compose -f compose.worker.yml up -d --no-build media-worker

worker_state=""
for _ in $(seq 1 90); do
  worker_state="$(docker inspect --format='{{.State.Health.Status}}' 4short-worker-media-worker-1 2>/dev/null || true)"
  if [[ "${worker_state}" == "healthy" ]]; then
    break
  fi
  sleep 2
done

if [[ "${worker_state}" != "healthy" ]]; then
  docker compose -f compose.worker.yml logs --tail 150 media-worker >&2 || true
  exit 1
fi

ln -sfn "${release_dir}" "${current_link}"
rm -f "${archive_path}"
trap - ERR

echo "Media worker release ${release_sha} is healthy."
