{
	email {$ACME_EMAIL}
	admin 127.0.0.1:2019
}

{$WEB_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Powered-By
		Server "4Short"
	}

	@next_static path /_next/static/*
	header @next_static Cache-Control "public, max-age=31536000, immutable"

	request_body {
		max_size 2MB
	}

	reverse_proxy 127.0.0.1:3000 {
		health_uri /
		health_interval 30s
		lb_try_duration 5s

		transport http {
			dial_timeout 2s
			response_header_timeout 35s
		}
	}

	log {
		output file /var/log/caddy/4short-web-access.log {
			roll_size 20MB
			roll_keep 5
			roll_keep_for 168h
		}
		format json
	}
}

{$API_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Powered-By
		Server "4Short"
	}

	request_body {
		max_size 2MB
	}

	reverse_proxy 127.0.0.1:4100 {
		health_uri /health/live
		health_interval 30s
		lb_try_duration 5s

		transport http {
			dial_timeout 2s
			response_header_timeout 35s
		}
	}

	log {
		output file /var/log/caddy/4short-access.log {
			roll_size 20MB
			roll_keep 5
			roll_keep_for 168h
		}
		format json
	}
}
