# Add this site block to the existing shared Caddy configuration after the
# dedicated narezai_edge network is attached. Preserve all existing sites.
api.narezai.com {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Video bytes travel browser -> private S3, never through the control API.
	request_body {
		max_size 2MB
	}

	reverse_proxy narezai-control-api:4100 {
		health_uri /health/ready
		health_interval 20s
		health_timeout 5s
		lb_try_duration 5s

		transport http {
			dial_timeout 2s
			response_header_timeout 35s
		}
	}

	log {
		output stdout
		format json
	}
}
