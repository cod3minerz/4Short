{
  "name": "4short-landing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "predev": "npm run build:contracts",
    "dev:api": "tsx watch services/control-api/src/server.ts",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:vercel": "next build",
    "prebuild:vercel": "npm run build:contracts",
    "build:contracts": "tsc -p packages/contracts/tsconfig.build.json",
    "audit:dark-surfaces": "node scripts/audit-dark-surfaces.mjs app/landing.css app/dashboard/dashboard.css",
    "release:check-domain": "node scripts/check-domain-readiness.mjs",
    "build:api": "tsc -p services/control-api/tsconfig.json",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:api": "node services/control-api/dist/services/control-api/src/server.js",
    "test": "npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:integration:queue": "tsx --test tests/integration/queue-pg.test.ts",
    "test:integration:queue-load": "tsx --test tests/integration/queue-load-pg.test.ts",
    "test:worker": "python3 -m unittest discover -s services/media-worker/tests",
    "test:hve-evaluator": "PYTHONPATH=services/media-worker/src:services/hve-evaluator/src ${HVE_EVALUATOR_PYTHON:-python3} -m unittest discover -s services/hve-evaluator/tests",
    "typecheck": "tsc --noEmit && tsc -p services/control-api/tsconfig.json",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check": "drizzle-kit check",
    "hve:manifest:lint": "node scripts/hve/validate-corpus.mjs verification/hve/manifests/smoke-v1.json --manifest-lint",
    "hve:corpus:verify": "node scripts/hve/validate-corpus.mjs verification/hve/manifests/smoke-v1.json",
    "hve:corpus:index": "node scripts/hve/build-corpus-object-index.mjs",
    "hve:benchmark": "PYTHONPATH=services/media-worker/src ${HVE_PYTHON:-python3} -m fourshort_worker.benchmark",
    "hve:benchmark:baseline": "node scripts/hve/worker-benchmark-baseline.mjs",
    "hve:assemble:release": "node scripts/hve/assemble-production-release-evidence.mjs",
    "hve:verify:release": "node scripts/hve/validate-production-release.mjs",
    "hve:smoke:g2": "node scripts/hve/run-hve2-smoke.mjs",
    "hve:smoke:g3": "node scripts/hve/run-hve3-smoke.mjs",
    "hve:smoke:g4": "node scripts/hve/run-hve4-smoke.mjs",
    "hve:smoke:g5": "node scripts/hve/run-hve5-smoke.mjs",
    "hve:evaluate:active-speaker": "node scripts/hve/evaluate-active-speaker-benchmark.mjs",
    "hve:assemble:active-speaker": "PYTHONPATH=services/media-worker/src:services/hve-evaluator/src ${HVE_EVALUATOR_PYTHON:-python3} -m hve_evaluator.prediction_bundle",
    "hve:sign:evaluator-bundle": "node scripts/hve/sign-evaluator-bundle.mjs",
    "hve:verify:active-speaker": "node scripts/hve/validate-active-speaker-benchmark.mjs",
    "hve:evaluate:layout-director": "node scripts/hve/evaluate-layout-director-benchmark.mjs",
    "hve:verify:layout-director": "node scripts/hve/validate-layout-director-benchmark.mjs",
    "hve:smoke:g6": "node scripts/hve/run-hve6-smoke.mjs",
    "hve:smoke:g7": "node scripts/hve/run-hve7-smoke.mjs",
    "hve:smoke:g8": "node scripts/hve/run-hve8-smoke.mjs",
    "hve:gate": "node scripts/hve/run-gate.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.3",
    "@fontsource-variable/manrope": "^5.2.8",
    "@heroui/react": "^3.0.5",
    "@heroui/styles": "^3.0.5",
    "@hookform/resolvers": "^5.2.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.12",
    "@paper-design/shaders-react": "^0.0.78",
    "@types/mdx": "^2.0.14",
    "better-auth": "^1.6.25",
    "drizzle-orm": "0.45.2",
    "fast-uri": "^4.1.1",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.1.0",
    "lucide-react": "^0.468.0",
    "next": "^16.2.12",
    "postgres": "^3.4.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.62.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "^8.5.19",
    "sharp": "^0.35.0"
  },
  "type": "module"
}
